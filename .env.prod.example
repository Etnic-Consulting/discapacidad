# SMT-ONIC · variables de entorno de PRODUCCIÓN
# ================================================
# Copiar a .env.prod en el servidor cloud y RELLENAR todos los valores marcados
# con CAMBIAR_AQUI antes del primer deploy.
#
# NUNCA committear .env.prod a git (ya está en .gitignore).
# NUNCA enviar .env.prod por Slack/email — usar canal seguro (Signal/Wire).
#
# Generado por Sprint S2.B02 · 2026-05-02
# Doctrina: _docs/PROTOCOLO_ROTACION_SECRETOS.md (Sprint S2.C02)

# ============================================
# 1 · DATABASE · PostgreSQL 16 + PostGIS 3.4
# ============================================
# Generar password con: openssl rand -hex 24
DB_PASSWORD=CAMBIAR_AQUI_OPENSSL_RAND_HEX_24

# Host/port internos al docker network · NO cambiar para deploy estándar
DB_HOST=db
DB_PORT=5432
DB_NAME=smt_onic
DB_USER=smt_admin

# URLs completas (derivadas · backend usa estas) · NO cambiar manualmente
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL_SYNC=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# 2 · AUTENTICACIÓN JWT
# ============================================
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_AQUI_OPENSSL_RAND_HEX_32

# Tiempo de vida del token (minutos) · 480 = 8h sesión
JWT_EXPIRES_MINUTES=480

# ============================================
# 3 · CORS · dominios permitidos
# ============================================
# Solo dominios reales de producción · NO incluir localhost en prod
CORS_ORIGINS='["https://smt-onic.com","https://www.smt-onic.com"]'

# ============================================
# 4 · DATOS · paths absolutos en el servidor
# ============================================
# Donde vive bd_consolidada/ tras descomprimir bd_consolidada.tar.gz
DISCAPACIDAD_DIR=/data/discapacidad

# Donde vive RUV (puede ser idéntico al anterior si se consolidaron)
VICTIMAS_DIR=/data/discapacidad/fuentes_externas/RUV

# ============================================
# 5 · API SERVER
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ============================================
# 6 · FRONTEND (build-time)
# ============================================
# En producción detrás de nginx · usar path relativo
VITE_API_URL=/api

# ============================================
# 7 · FEATURE FLAGS
# ============================================
# Activar nuevo endpoint /proyecciones (T08) · default true post-S1
FEATURE_PROYECCIONES_ENABLED=true

# Aplicar FAC en /intercensal por default (puede sobreescribirse con query param)
FEATURE_FAC_DEFAULT=false

# ============================================
# 8 · OBSERVABILIDAD (opcional · v1.1)
# ============================================
# SENTRY_DSN=https://...@sentry.io/...
# DATADOG_API_KEY=...

# ============================================
# 9 · BACKUP
# ============================================
# Ruta donde cron pg_dump escribe backups
BACKUP_DIR=/var/backups/smt-onic
# Días de retención (cron purga >N días)
BACKUP_RETENTION_DAYS=7

# ============================================
# 10 · GIT (para ci.yml y deploy.yml)
# ============================================
# Sólo si CI necesita pushear · normalmente no
# GITHUB_PAT=ghp_...
